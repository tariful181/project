LIVEKIT_URL=<your LiveKit server URL>
LIVEKIT_API_KEY=<your API Key>
LIVEKIT_API_SECRET=<your API Secret>
OPENAI_API_KEY=<your OpenAI API Key>
DEEPGRAM_API_KEY=<your Deepgram API Key>
# Leave empty for auto-dispatch in Playground.
# Set a value only if you will select the same agent name in Playground explicit dispatch.
AGENT_NAME=

# STT Configuration (Deepgram - Excellent Bangla Support)
STT_MODEL=nova-2
STT_LANGUAGE=bn

# Optional model tuning
LLM_MODEL=gpt-4.1
TTS_MODEL=gpt-4o-mini-tts
TTS_VOICE=cedar
TTS_SPEED=0.94
TTS_INSTRUCTIONS=Speak in natural conversational Bangla with a warm, human tone. Use clear Bangladeshi pronunciation, gentle intonation, and short pauses between clauses. Avoid robotic rhythm; sound friendly and confident.
